{
  "name": "@moshpits/rux",
  "version": "0.2.4",
  "private": false,
  "license": "Apache-2.0",
  "description": "Test-first run ledger for AI coding agents — record real Claude Code, Codex, and Gemini CLI runs, attach checks and verdicts, and route the next task on local evidence.",
  "author": "Moshpit Labs",
  "keywords": [
    "ai",
    "agents",
    "coding-agent",
    "claude-code",
    "codex",
    "gemini-cli",
    "cli",
    "developer-tools",
    "run-ledger",
    "evals",
    "routing",
    "orchestration",
    "evidence"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moshpit-Labs/rux.git"
  },
  "bugs": {
    "url": "https://github.com/Moshpit-Labs/rux/issues"
  },
  "homepage": "https://github.com/Moshpit-Labs/rux#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "rux": "src/cli.mjs"
  },
  "files": [
    "src/",
    "rux.policy.json"
  ],
  "scripts": {
    "check": "node --check src/cli.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "smoke": "node tests/smoke.mjs",
    "release:verify": "npm run check && npm run check:docs && npm run smoke && node src/cli.mjs release-check --strict",
    "prepublishOnly": "npm run release:verify"
  },
  "engines": {
    "node": ">=20"
  }
}
